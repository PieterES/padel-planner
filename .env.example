# Secret for admin access: open <PUBLIC_URL>/admin/login?token=<ADMIN_TOKEN> once.
# Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me
# Port on the Pi for the web app; point the Cloudflare Tunnel at http://localhost:<WEB_PORT>
WEB_PORT=3010
# Public URL behind the Cloudflare Tunnel; used to build friends' magic links
PUBLIC_URL=https://padel.example.com
TZ=Europe/Amsterdam
# Optional: Cloudflare Tunnel token for `docker compose --profile tunnel up -d`
TUNNEL_TOKEN=
